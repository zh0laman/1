DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/alem_rag
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── LLM (Chat + Embeddings) ───────────────────────────────────────────────────
LLM_BASE_URL=https://llm.nitec.kz
LLM_API_KEY=your-alem-cloud-api-key
LLM_CHAT_MODEL=alemgpt-intent
LLM_EMBEDDING_MODEL=BAAI/bge-m3

# ─── MinIO (Object Storage) ─────────────────────────────────────────────────────
# В docker-compose endpoint = minio:9000; локально вне docker = localhost:9000
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_SECURE=false

# ─── RAG Pipeline ───────────────────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64
EMBEDDING_DIM=1024
RAG_TOP_K=5
